# ==========================================
# Enterprise Knowledge Platform (EKP)
# Version 9 – Enterprise Web UI
# ==========================================

# -------------------------------------------------
# Google Gemini API Configuration
# -------------------------------------------------

GOOGLE_API_KEY=your_google_gemini_api_key

# -------------------------------------------------
# Application Configuration
# -------------------------------------------------

APP_NAME=Enterprise Knowledge Platform
APP_VERSION=9.0.0
ENVIRONMENT=development

# Options:
# development
# testing
# production

DEBUG=True

# -------------------------------------------------
# Server Configuration
# -------------------------------------------------

HOST=127.0.0.1
PORT=8000

# -------------------------------------------------
# Vector Database Configuration
# -------------------------------------------------

CHROMA_DB_PATH=./chroma_db

# -------------------------------------------------
# Embedding Model
# -------------------------------------------------

EMBEDDING_MODEL=all-MiniLM-L6-v2

# -------------------------------------------------
# Logging
# -------------------------------------------------

LOG_LEVEL=INFO

# Options:
# DEBUG
# INFO
# WARNING
# ERROR
# CRITICAL

# -------------------------------------------------
# File Upload Settings
# -------------------------------------------------

MAX_UPLOAD_SIZE_MB=20

# -------------------------------------------------
# Future Configuration (Reserved)
# -------------------------------------------------

# DATABASE_URL=
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------------------------------------
# Notes
# -------------------------------------------------

# 1. Copy this file and rename it to ".env"
#
# 2. Replace the placeholder values with your own.
#
# 3. Never commit your actual ".env" file to GitHub.
#
# 4. Keep API keys and secrets private.